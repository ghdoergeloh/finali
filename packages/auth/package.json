{
  "name": "@finali/auth",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./auth": "./src/auth.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "generate": "dotenv -e ../../.env -- pnpx @better-auth/cli generate --output ../db/src/schema/auth-schema.ts",
    "lint": "eslint",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@finali/prettier-config",
  "dependencies": {
    "@finali/db": "workspace:*",
    "@finali/transactional": "workspace:*",
    "better-auth": "^1.6.25",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@better-auth/cli": "catalog:",
    "@finali/eslint-config": "workspace:*",
    "@finali/prettier-config": "workspace:*",
    "@finali/tsconfig": "workspace:*",
    "@finali/vitest": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
