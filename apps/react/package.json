{
  "name": "@finali/react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "vite",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "prettier": "@finali/prettier-config",
  "dependencies": {
    "@finali/auth": "workspace:*",
    "@finali/contract": "workspace:*",
    "@finali/ui": "workspace:*",
    "@orpc/client": "^1.14.15",
    "@orpc/react-query": "^1.14.15",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.22",
    "@tanstack/react-router-devtools": "^1.167.1",
    "react": "catalog:react19",
    "react-dom": "catalog:react19"
  },
  "devDependencies": {
    "@finali/eslint-config": "workspace:*",
    "@finali/prettier-config": "workspace:*",
    "@finali/tailwind-config": "workspace:*",
    "@finali/tsconfig": "workspace:*",
    "@finali/vitest": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "^1.168.27",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
